# Copy to .env and fill in. Never commit .env.

# Public DNS name of this host for sign-in (Keycloak behind HTTPS). Must resolve to this host.
AUTH_DOMAIN=id.example.com
# Let's Encrypt account email for the certificate.
ACME_EMAIL=admin@example.com

POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-too

# Game server
VB_VERSION=v0.1.5
GAME_PORT=7777
MAX_PLAYERS=32
VIEW_DISTANCE=6
MOTD=Welcome to Blockopia

# 1 = no sign-in at all: anyone can join under any name and take over that account.
# Only for a LAN or a quick test. Leave at 0 for a public server.
BLOCKOPIA_NO_AUTH=0
